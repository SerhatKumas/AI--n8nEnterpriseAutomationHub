# ==============================================================================
# n8n + Caddy (Automatic HTTPS) Configuration Template
# ==============================================================================

# Domain Configuration
DOMAIN_NAME=n8n.codewaft.com

# Contact email for Let's Encrypt SSL renewal notifications
SSL_EMAIL=info@codewaft.com

# Timezone (e.g., Europe/Istanbul, Europe/Berlin, America/New_York)
GENERIC_TIMEZONE=Europe/Istanbul

# n8n Docker image tag
N8N_VERSION=latest

# Secure encryption key for n8n credentials (generate a random 32+ char string)
N8N_ENCRYPTION_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_12345
