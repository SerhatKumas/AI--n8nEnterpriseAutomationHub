# VAPI & TWILIO CREDENTIALS
VAPI_API_KEY=your_vapi_api_key
VAPI_ASSISTANT_ID=your_vapi_assistant_id
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# N8N SERVER SETTINGS
N8N_BASE_URL=https://n8n.codewaft.com
N8N_WEBHOOK_TOOLS_PATH=/webhook/vapi-tools
N8N_WEBHOOK_END_OF_CALL_PATH=/webhook/vapi-end-of-call

# TELEGRAM BOT CREDENTIALS (Customer Call Bot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here
